{
	"extends": ["@sapphire/ts-config", "@sapphire/ts-config/extra-strict", "@sapphire/ts-config/decorators"],
	"compilerOptions": {
		"rootDir": "src",
		"outDir": "dist",
		"tsBuildInfoFile": "dist/.tsbuildinfo",
		"declaration": false,
		"declarationMap": false,
    	"esModuleInterop": true,
		"skipLibCheck": true
	},
  	"include": ["src/**/*"]
}